   "patch": [
    {
     "id": "p-core",
     "text": "diff --git \"a/x\" \"b/x\"\n--- \"a/x\"\n+++ \"b/x\"\n@@ -3,3 +3,3 @@\n keep\n-old\n+new\n tail\n"
    },
    {
     "id": "p-two-hunks",
     "text": "diff --git a/f b/f\nindex 1..2 100644\n--- a/f\n+++ b/f\n@@ -1,2 +1,2 @@\n keep\n--- old comment\n+-- new comment\n\\ No newline at end of file\n@@ -10 +10,3 @@\n x\n-y\n+y2\n+y3\n"
    },
    {
     "id": "p-runs",
     "text": "@@ -1,5 +1,6 @@\n a\n-b\n-c\n+B\n+C\n+D\n d\n-e\n\\ No newline at end of file\n@@ -20 +21 @@\n+z\n"
    },
    {
     "id": "l-diff-u",
