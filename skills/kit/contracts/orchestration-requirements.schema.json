{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/orchestration-requirements.schema.json",
  "title": "Portable orchestration requirement contract",
  "type": "object",
  "required": [
    "version",
    "workflow_kind",
    "required_operations",
    "roles",
    "seat_template",
    "refusals",
    "result_routing",
    "trace_cases"
  ],
  "properties": {
    "version": { "const": 1 },
    "workflow_kind": { "type": "string" },
    "required_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "resolve_roles",
          "validate_host_capabilities",
          "create_owned_visible_leaves",
          "dispatch",
          "accept_durable_results",
          "report_degradation",
          "close_owned_leaves"
        ]
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "seat_template": {
      "type": "object",
      "required": ["isolation", "visibility", "permission", "artifact"],
      "properties": {
        "isolation": { "type": "string" },
        "visibility": { "type": "string" },
        "permission": { "type": "string" },
        "artifact": { "type": "string" },
        "deadline": { "type": "string" }
      },
      "additionalProperties": false
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "condition",
          "detectable",
          "side_effects_may_have_occurred",
          "disposition"
        ],
        "properties": {
          "condition": { "type": "string" },
          "detectable": { "enum": ["pre-dispatch", "post-dispatch"] },
          "side_effects_may_have_occurred": { "type": "boolean" },
          "disposition": {
            "enum": [
              "refuse",
              "degrade-and-report",
              "quarantine-and-escalate",
              "halt-and-notify"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "result_routing": { "type": "object" },
    "trace_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["id"] }
    }
  },
  "additionalProperties": true
}
